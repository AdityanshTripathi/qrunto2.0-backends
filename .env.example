# Supabase Postgres runtime connection (transaction pooler, port 6543).
# Copy the exact URI from Supabase Dashboard > Connect > Transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require"

# Prisma CLI connection (session pooler, port 5432).
# This is used by prisma.config.ts for schema and migration commands.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require"

PORT=5000
NODE_ENV="development"
# Comma-separated exact browser origins. Required in production; wildcards are rejected.
CORS_ALLOWED_ORIGINS="https://ordio.in,https://www.ordio.in"
# Optional separate trusted apps; both are merged with CORS_ALLOWED_ORIGINS.
FRONTEND_URL="https://www.ordio.in"
ADMIN_URL=""
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
APP_BASE_URL="http://localhost:5000"

# Optional WhatsApp Cloud API integration.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
