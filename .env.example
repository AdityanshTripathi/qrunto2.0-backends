# Supabase Postgres runtime connection (transaction pooler, port 6543).
# Copy the exact URI from Supabase Dashboard > Connect > Transaction pooler.
# Runtime pg.Pool settings live in src/lib/prisma.ts: max=1, connect/idle timeout=10000ms.
# connection_limit in the URL does not configure the pg driver pool.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require"

# Prisma CLI connection (session pooler, port 5432).
# This is used by prisma.config.ts for schema and migration commands.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require"

PORT=5000
# External QStash schedule: */2 * * * * (UTC), GET /api/internal/cron/crm.
# Forward Authorization: Bearer <CRON_SECRET>. Use a random 32+ character secret.
CRON_SECRET=""
# Shared Socket.IO Pub/Sub and CRM locks. Copy the provider's native TCP/TLS URL,
# e.g. rediss://<username>:<password>@<host>:<port> (not an HTTPS REST endpoint).
# Required for cron and multi-instance sockets; optional for single-process local dev.
REDIS_URL=""
# Legacy compatibility only; ignored when REDIS_URL is set. Do not set both.
SOCKET_REDIS_URL=""
NODE_ENV="development"
# Comma-separated exact browser origins. Required in production; wildcards are rejected.
CORS_ALLOWED_ORIGINS="https://ordio.in,https://www.ordio.in"
# Optional separate trusted apps; both are merged with CORS_ALLOWED_ORIGINS.
FRONTEND_URL="https://www.ordio.in"
ADMIN_URL=""
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
APP_BASE_URL="http://localhost:5000"

# Optional WhatsApp Cloud API integration.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Never enable in production. Allows /send-test only in development/test.
ENABLE_WHATSAPP_SEND_TEST="false"
