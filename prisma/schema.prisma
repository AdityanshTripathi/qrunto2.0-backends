generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(uuid())
  name                 String
  email                String                 @unique
  password             String
  role                 UserRole               @default(RESTAURANT_OWNER)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  restaurantId         String?                @map("restaurant_id")
  isActive             Boolean?               @default(true) @map("is_active")
  phone                String?
  assignedTickets      ComplaintTicket[]
  customerNotes        CustomerNote[]
  order_status_history order_status_history[]
  restaurants          Restaurant[]
  stockAudits          StockAudit[]
  stockLedgers         StockLedger[]
  approvedTransfers    StockTransfer[]        @relation("ApprovedTransfers")
  createdTransfers     StockTransfer[]        @relation("CreatedTransfers")
  wastageRecords       WastageRecord[]

  @@map("users")
}

model Brand {
  id           String            @id @default(uuid())
  name         String
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  campaigns    Campaign[]
  tickets      ComplaintTicket[]
  coupons      Coupon[]
  customers    Customer[]
  loyaltyTiers LoyaltyTier[]
  restaurants  Restaurant[]
  segments     Segment[]

  @@map("brands")
}

model Restaurant {
  id                    String                      @id @default(uuid())
  ownerId               String                      @map("owner_id")
  name                  String
  slug                  String                      @unique
  logoUrl               String?                     @map("logo_url")
  phone                 String?
  email                 String?
  address               String?
  gstNumber             String?                     @map("gst_number")
  isActive              Boolean                     @default(true) @map("is_active")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  brandId               String?                     @map("brand_id")
  analytics_events      analytics_events[]
  analyticsSnapshots    AnalyticsSnapshot[]
  categories            Category[]
  customerProfiles      CustomerRestaurantProfile[]
  expenses              expenses[]
  invoices              Invoice[]
  menuItems             MenuItem[]
  menuViewLogs          MenuViewLog[]
  cartSessions          CartSession[]
  notifications         Notification[]
  orders                Order[]
  passcodeResetRequests PasscodeResetRequest[]
  payments              Payment[]
  promoRedemptions      PromoRedemption[]
  purchaseOrders        PurchaseOrder[]
  rawMaterials          RawMaterial[]
  settings              RestaurantSetting?
  tables                RestaurantTable[]
  brand                 Brand?                      @relation(fields: [brandId], references: [id])
  owner                 User                        @relation(fields: [ownerId], references: [id])
  stockAudits           StockAudit[]
  stockLedgers          StockLedger[]
  destTransfers         StockTransfer[]             @relation("DestBranchTransfers")
  sourceTransfers       StockTransfer[]             @relation("SourceTransfers")
  subscriptions         Subscription[]
  suppliers             Supplier[]
  transactions          Transaction[]
  waiters               Waiter[]
  wastageRecords        WastageRecord[]

  @@map("restaurants")
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  price         Float
  durationDays  Int            @map("duration_days")
  maxTables     Int            @map("max_tables")
  maxMenuItems  Int            @map("max_menu_items")
  featuresJson  Json?          @map("features_json")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  price6Month   Float          @default(0) @map("price_6_month")
  price1Year    Float          @default(0) @map("price_1_year")
  promoCodes    PromoCode[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id           String             @id @default(uuid())
  restaurantId String             @map("restaurant_id")
  planId       String             @map("plan_id")
  status       SubscriptionStatus @default(PENDING)
  startDate    DateTime           @map("start_date")
  endDate      DateTime           @map("end_date")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("subscriptions")
}

model PromoCode {
  id           String            @id @default(uuid())
  code         String            @unique
  type         PromoCodeType
  value        Float
  usageLimit   Int?              @default(1) @map("usage_limit")
  usageCount   Int               @default(0) @map("usage_count")
  expiresAt    DateTime?         @map("expires_at")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  durationDays Int?              @map("duration_days")
  planId       String?           @map("plan_id")
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  redemptions  PromoRedemption[]

  @@index([planId])
  @@map("promo_codes")
}

model PromoRedemption {
  id                String     @id @default(uuid())
  promoCodeId       String     @map("promo_code_id")
  restaurantId      String     @map("restaurant_id")
  redeemedAt        DateTime   @default(now()) @map("redeemed_at")
  subscriptionEnd   DateTime?  @map("subscription_end")
  subscriptionStart DateTime?  @map("subscription_start")
  promoCode         PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([promoCodeId])
  @@map("promo_redemptions")
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  name         String
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id                      String      @id @default(uuid())
  restaurantId            String      @map("restaurant_id")
  categoryId              String      @map("category_id")
  name                    String
  description             String?
  price                   Float
  imageUrl                String?     @map("image_url")
  isAvailable             Boolean     @default(true) @map("is_available")
  isFeatured              Boolean     @default(false) @map("is_featured")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  foodType                String      @default("veg") @map("food_type")
  isCompleteYourMeal      Boolean     @default(true) @map("is_complete_your_meal")
  is_combo                Boolean     @default(false)
  target_preparation_time Int         @default(15)
  view_count              Int         @default(0)
  category                Category    @relation(fields: [categoryId], references: [id])
  restaurant              Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems              OrderItem[]
  recipe                  Recipe?

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  tableNumber  String     @map("table_number")
  qrCodeUrl    String?    @map("qr_code_url")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  orders       Order[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("restaurant_tables")
}

model Order {
  id                   String                 @id @default(uuid())
  restaurantId         String                 @map("restaurant_id")
  tableId              String?                @map("table_id")
  orderNumber          String                 @map("order_number")
  status               OrderStatus            @default(NEW)
  subtotal             Float
  taxAmount            Float                  @map("tax_amount")
  totalAmount          Float                  @map("total_amount")
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  customerName         String?                @map("customer_name")
  customerPhone        String?                @map("customer_phone")
  invoiceNumber        String?                @map("invoice_number")
  kotNumber            String?                @map("kot_number")
  customerId           String?                @map("customer_id")
  source               OrderSource            @default(QR_SCAN)
  type                 OrderType              @default(DINE_IN)
  prepStartedAt        DateTime?              @map("prep_started_at")
  servedAt             DateTime?              @map("served_at")
  assignedWaiterId     String?                @map("assigned_waiter_id")
  assignedWaiter       Waiter?                @relation(fields: [assignedWaiterId], references: [id])
  couponsRedeemed      CustomerCoupon[]
  feedback             Feedback?
  invoice              Invoice?
  loyaltyLedgers       LoyaltyLedger[]
  orderItems           OrderItem[]
  order_status_history order_status_history[]
  customer             Customer?              @relation(fields: [customerId], references: [id])
  restaurant           Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                RestaurantTable?       @relation(fields: [tableId], references: [id])
  payments             Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([customerId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([source])
  @@index([type])
  @@map("orders")
}

model OrderItem {
  id                      String    @id @default(uuid())
  orderId                 String    @map("order_id")
  menuItemId              String?   @map("menu_item_id")
  itemName                String    @map("item_name")
  quantity                Int
  unitPrice               Float     @map("unit_price")
  totalPrice              Float     @map("total_price")
  createdAt               DateTime  @default(now()) @map("created_at")
  selected_modifiers_json Json?
  menuItem                MenuItem? @relation(fields: [menuItemId], references: [id])
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  restaurantId      String        @map("restaurant_id")
  orderId           String?       @map("order_id")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  amount            Float
  refundedAmount    Float         @default(0) @map("refunded_amount")
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?       @map("payment_method")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([restaurantId])
  @@index([orderId])
  @@index([restaurantId, paidAt])
  @@map("payments")
}

model Transaction {
  id              String     @id @default(uuid())
  restaurantId    String     @map("restaurant_id")
  paymentId       String?    @map("payment_id")
  amount          Float
  transactionType String     @map("transaction_type")
  reference       String?
  createdAt       DateTime   @default(now()) @map("created_at")
  payment         Payment?   @relation(fields: [paymentId], references: [id])
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([paymentId])
  @@map("transactions")
}

model RestaurantSetting {
  id                String     @id @default(uuid())
  restaurantId      String     @unique @map("restaurant_id")
  currency          String     @default("INR")
  taxPercentage     Float      @default(0) @map("tax_percentage")
  businessHours     Json?      @map("business_hours")
  themeSettings     Json?      @map("theme_settings")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  isPasscodeEnabled Boolean    @default(false) @map("is_passcode_enabled")
  passcode          String?    @map("passcode")
  invoiceSeries     String?    @default("INV") @map("invoice_series")
  kotSeries         String?    @default("KOT") @map("kot_series")
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model Invoice {
  id            String     @id @default(uuid())
  restaurantId  String     @map("restaurant_id")
  orderId       String     @unique @map("order_id")
  invoiceNumber String     @map("invoice_number")
  subtotal      Float
  discount      Float      @default(0)
  gst           Float      @default(0)
  grandTotal    Float      @map("grand_total")
  paymentMethod String     @map("payment_method")
  paymentStatus String     @map("payment_status")
  createdAt     DateTime   @default(now()) @map("created_at")
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@map("invoices")
}

model AnalyticsSnapshot {
  id                String     @id @default(uuid())
  restaurantId      String     @map("restaurant_id")
  date              DateTime
  totalOrders       Int        @default(0) @map("total_orders")
  totalRevenue      Float      @default(0) @map("total_revenue")
  averageOrderValue Float      @default(0) @map("average_order_value")
  createdAt         DateTime   @default(now()) @map("created_at")
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
  @@map("analytics_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id           String           @id @default(uuid())
  restaurantId String?          @map("restaurant_id")
  title        String
  message      String
  type         NotificationType @default(SYSTEM)
  isRead       Boolean          @default(false) @map("is_read")
  createdAt    DateTime         @default(now()) @map("created_at")
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isRead])
  @@map("notifications")
}

model PasscodeResetRequest {
  id           String              @id @default(uuid())
  restaurantId String              @map("restaurant_id")
  status       PasscodeResetStatus @default(PENDING)
  requestedAt  DateTime            @default(now()) @map("requested_at")
  processedAt  DateTime?           @map("processed_at")
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("passcode_reset_requests")
}

model Waiter {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  name         String
  email        String     @unique
  phone        String
  passwordHash String     @map("password_hash")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId])
  @@map("waiters")
}

model Customer {
  id                String                      @id @default(uuid())
  brandId           String                      @map("brand_id")
  name              String
  phone             String
  email             String?
  acquisitionSource String                      @default("QR_ORDER") @map("acquisition_source")
  metadataJson      Json?                       @map("metadata_json")
  aiSummary         String?                     @map("ai_summary")
  birthday          DateTime?
  anniversary       DateTime?
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  campaignLogs      CampaignLog[]
  tickets           ComplaintTicket[]
  coupons           CustomerCoupon[]
  notes             CustomerNote[]
  profiles          CustomerRestaurantProfile[]
  segments          CustomerSegment[]
  brand             Brand                       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  feedbacks         Feedback[]
  loyaltyAccount    LoyaltyAccount?
  orders            Order[]

  @@unique([brandId, phone])
  @@index([phone])
  @@index([brandId])
  @@map("customers")
}

model CustomerRestaurantProfile {
  id               String       @id @default(uuid())
  customerId       String       @map("customer_id")
  restaurantId     String       @map("restaurant_id")
  totalSpend       Float        @default(0) @map("total_spend")
  totalOrders      Int          @default(0) @map("total_orders")
  aov              Float        @default(0) @map("aov")
  ltv              Float        @default(0) @map("ltv")
  firstVisit       DateTime     @default(now()) @map("first_visit")
  lastVisit        DateTime     @default(now()) @map("last_visit")
  visitFrequency   Float        @default(0) @map("visit_frequency")
  repeatStatus     String       @default("NEW") @map("repeat_status")
  churnProbability Float        @default(0) @map("churn_probability")
  predictedLtv     Float        @default(0) @map("predicted_ltv")
  healthScore      Float        @default(100) @map("health_score")
  engagementScore  Float        @default(0) @map("engagement_score")
  loyaltyTierId    String?      @map("loyalty_tier_id")
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loyaltyTier      LoyaltyTier? @relation(fields: [loyaltyTierId], references: [id])
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
  @@map("customer_restaurant_profiles")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  noteText   String   @map("note_text")
  isSystem   Boolean  @default(false) @map("is_system")
  createdAt  DateTime @default(now()) @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@map("customer_notes")
}

model LoyaltyTier {
  id         String                      @id @default(uuid())
  brandId    String                      @map("brand_id")
  name       String
  minSpend   Float                       @default(0) @map("min_spend")
  multiplier Float                       @default(1.0)
  createdAt  DateTime                    @default(now()) @map("created_at")
  updatedAt  DateTime                    @updatedAt @map("updated_at")
  profiles   CustomerRestaurantProfile[]
  brand      Brand                       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@map("loyalty_tiers")
}

model LoyaltyAccount {
  id             String          @id @default(uuid())
  customerId     String          @unique @map("customer_id")
  pointsBalance  Int             @default(0) @map("points_balance")
  lifetimePoints Int             @default(0) @map("lifetime_points")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ledger         LoyaltyLedger[]

  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id               String                 @id @default(uuid())
  loyaltyAccountId String                 @map("loyalty_account_id")
  points           Int
  transactionType  LoyaltyTransactionType @map("transaction_type")
  description      String
  orderId          String?                @map("order_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order            Order?                 @relation(fields: [orderId], references: [id])

  @@index([loyaltyAccountId])
  @@map("loyalty_ledgers")
}

model Coupon {
  id                String             @id @default(uuid())
  brandId           String             @map("brand_id")
  code              String
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Float              @map("discount_value")
  minOrderAmount    Float              @default(0) @map("min_order_amount")
  maxDiscountAmount Float?             @map("max_discount_amount")
  startDate         DateTime           @map("start_date")
  endDate           DateTime           @map("end_date")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  issuances         CustomerCoupon[]

  @@unique([brandId, code])
  @@map("coupons")
}

model CustomerCoupon {
  id         String    @id @default(uuid())
  couponId   String    @map("coupon_id")
  customerId String    @map("customer_id")
  isRedeemed Boolean   @default(false) @map("is_redeemed")
  redeemedAt DateTime? @map("redeemed_at")
  orderId    String?   @map("order_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?    @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@map("customer_coupons")
}

model Segment {
  id           String            @id @default(uuid())
  brandId      String            @map("brand_id")
  name         String
  description  String?
  criteriaJson Json              @map("criteria_json")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  campaigns    Campaign[]
  customers    CustomerSegment[]
  brand        Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@map("segments")
}

model CustomerSegment {
  id         String   @id @default(uuid())
  segmentId  String   @map("segment_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@map("customer_segments")
}

model Campaign {
  id              String          @id @default(uuid())
  brandId         String          @map("brand_id")
  name            String
  channel         CampaignChannel
  segmentId       String?         @map("segment_id")
  templateSubject String?         @map("template_subject")
  templateBody    String          @map("template_body")
  status          CampaignStatus  @default(DRAFT)
  scheduledAt     DateTime        @map("scheduled_at")
  sentCount       Int             @default(0) @map("sent_count")
  failedCount     Int             @default(0) @map("failed_count")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  logs            CampaignLog[]
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  segment         Segment?        @relation(fields: [segmentId], references: [id])

  @@map("campaigns")
}

model CampaignLog {
  id           String            @id @default(uuid())
  campaignId   String            @map("campaign_id")
  customerId   String            @map("customer_id")
  status       CampaignLogStatus @default(PENDING)
  errorDetails String?           @map("error_details")
  createdAt    DateTime          @default(now()) @map("created_at")
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("campaign_logs")
}

model Feedback {
  id         String           @id @default(uuid())
  orderId    String           @unique @map("order_id")
  customerId String           @map("customer_id")
  rating     Int
  comments   String?
  createdAt  DateTime         @default(now()) @map("created_at")
  ticket     ComplaintTicket?
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model ComplaintTicket {
  id             String       @id @default(uuid())
  brandId        String       @map("brand_id")
  feedbackId     String?      @unique @map("feedback_id")
  customerId     String       @map("customer_id")
  subject        String
  description    String
  status         TicketStatus @default(OPEN)
  assignedUserId String?      @map("assigned_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id])
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedback       Feedback?    @relation(fields: [feedbackId], references: [id])

  @@map("complaint_tickets")
}

model Supplier {
  id                 String          @id @default(uuid())
  restaurantId       String          @map("restaurant_id")
  name               String
  contactName        String?         @map("contact_name")
  phone              String
  email              String?
  gstNumber          String?         @map("gst_number")
  address            String?
  creditDays         Int             @default(0) @map("credit_days")
  outstandingBalance Float           @default(0) @map("outstanding_balance")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  purchaseOrders     PurchaseOrder[]
  rawMaterials       RawMaterial[]
  restaurant         Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("suppliers")
}

model RawMaterial {
  id                 String              @id @default(uuid())
  restaurantId       String              @map("restaurant_id")
  supplierId         String?             @map("supplier_id")
  name               String
  category           String
  sku                String
  unit               String
  openingStock       Float               @map("opening_stock")
  currentStock       Float               @map("current_stock")
  minimumStockLevel  Float               @map("minimum_stock_level")
  maximumStockLevel  Float               @map("maximum_stock_level")
  reorderQuantity    Float               @map("reorder_quantity")
  purchasePrice      Float               @map("purchase_price")
  averageCost        Float               @map("average_cost")
  lastPurchaseDate   DateTime?           @map("last_purchase_date")
  expiryDate         DateTime?           @map("expiry_date")
  storageLocation    String?             @map("storage_location")
  notes              String?
  status             RawMaterialStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  purchaseOrderItems PurchaseOrderItem[]
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  recipeIngredients  RecipeIngredient[]
  auditItems         StockAuditItem[]
  stockBatches       StockBatch[]
  stockLedgers       StockLedger[]
  transferItems      StockTransferItem[]
  wastageRecords     WastageRecord[]

  @@unique([restaurantId, sku])
  @@index([restaurantId])
  @@index([supplierId])
  @@map("raw_materials")
}

model Recipe {
  id          String             @id @default(uuid())
  menuItemId  String             @unique @map("menu_item_id")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  ingredients RecipeIngredient[]
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

model RecipeIngredient {
  id            String      @id @default(uuid())
  recipeId      String      @map("recipe_id")
  rawMaterialId String      @map("raw_material_id")
  quantity      Float
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, rawMaterialId])
  @@map("recipe_ingredients")
}

model StockBatch {
  id            String      @id @default(uuid())
  rawMaterialId String      @map("raw_material_id")
  batchNumber   String      @map("batch_number")
  quantity      Float
  purchasePrice Float       @map("purchase_price")
  expiryDate    DateTime    @map("expiry_date")
  receivedDate  DateTime    @default(now()) @map("received_date")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@index([rawMaterialId])
  @@index([expiryDate])
  @@map("stock_batches")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  restaurantId         String              @map("restaurant_id")
  supplierId           String              @map("supplier_id")
  poNumber             String              @map("po_number")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDate         DateTime?           @map("expected_date")
  receivedDate         DateTime?           @map("received_date")
  subtotal             Float
  gstAmount            Float               @map("gst_amount")
  grandTotal           Float               @map("grand_total")
  invoiceNumber        String?             @map("invoice_number")
  invoiceAttachmentUrl String?             @map("invoice_attachment_url")
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  items                PurchaseOrderItem[]
  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id])

  @@unique([restaurantId, poNumber])
  @@index([restaurantId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  poId          String        @map("po_id")
  rawMaterialId String        @map("raw_material_id")
  quantity      Float
  unitPrice     Float         @map("unit_price")
  gstPercentage Float         @default(0) @map("gst_percentage")
  totalCost     Float         @map("total_cost")
  expiryDate    DateTime?     @map("expiry_date")
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@map("purchase_order_items")
}

model WastageRecord {
  id            String        @id @default(uuid())
  restaurantId  String        @map("restaurant_id")
  rawMaterialId String        @map("raw_material_id")
  userId        String        @map("user_id")
  quantity      Float
  cost          Float
  reason        WastageReason
  notes         String?
  wasteDate     DateTime      @default(now()) @map("waste_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([rawMaterialId])
  @@map("wastage_records")
}

model StockTransfer {
  id             String              @id @default(uuid())
  brandId        String              @map("brand_id")
  sourceBranchId String              @map("source_branch_id")
  destBranchId   String              @map("dest_branch_id")
  transferNumber String              @map("transfer_number")
  status         TransferStatus      @default(PENDING)
  notes          String?
  createdById    String              @map("created_by_id")
  approvedById   String?             @map("approved_by_id")
  sentDate       DateTime?           @map("sent_date")
  receivedDate   DateTime?           @map("received_date")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  items          StockTransferItem[]
  approvedBy     User?               @relation("ApprovedTransfers", fields: [approvedById], references: [id])
  createdBy      User                @relation("CreatedTransfers", fields: [createdById], references: [id])
  destBranch     Restaurant          @relation("DestBranchTransfers", fields: [destBranchId], references: [id], onDelete: Cascade)
  sourceBranch   Restaurant          @relation("SourceTransfers", fields: [sourceBranchId], references: [id], onDelete: Cascade)

  @@unique([brandId, transferNumber])
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String        @id @default(uuid())
  transferId    String        @map("transfer_id")
  rawMaterialId String        @map("raw_material_id")
  quantity      Float
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model StockAudit {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  userId       String           @map("user_id")
  auditDate    DateTime         @default(now()) @map("audit_date")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  items        StockAuditItem[]
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@map("stock_audits")
}

model StockAuditItem {
  id            String      @id @default(uuid())
  auditId       String      @map("audit_id")
  rawMaterialId String      @map("raw_material_id")
  expectedStock Float       @map("expected_stock")
  actualStock   Float       @map("actual_stock")
  variance      Float
  notes         String?
  stockAudit    StockAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("stock_audit_items")
}

model StockLedger {
  id            String           @id @default(uuid())
  restaurantId  String           @map("restaurant_id")
  rawMaterialId String           @map("raw_material_id")
  userId        String?          @map("user_id")
  quantity      Float
  previousStock Float            @map("previous_stock")
  newStock      Float            @map("new_stock")
  actionType    LedgerActionType @map("action_type")
  referenceId   String?          @map("reference_id")
  reason        String?
  createdAt     DateTime         @default(now()) @map("created_at")
  rawMaterial   RawMaterial      @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([rawMaterialId])
  @@map("stock_ledgers")
}

model analytics_events {
  id            String     @id
  restaurant_id String
  event_type    EventType
  session_id    String
  item_id       String?
  metadata      Json?
  created_at    DateTime   @default(now())
  restaurants   Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([restaurant_id, event_type])
}

model expenses {
  id            String          @id
  restaurant_id String
  amount        Float
  category      ExpenseCategory
  description   String?
  expense_date  DateTime
  created_at    DateTime        @default(now())
  updated_at    DateTime
  restaurants   Restaurant      @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([expense_date])
  @@index([restaurant_id])
}

model order_status_history {
  id          String       @id
  order_id    String
  from_status OrderStatus?
  to_status   OrderStatus
  user_id     String?
  created_at  DateTime     @default(now())
  orders      Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users       User?        @relation(fields: [user_id], references: [id])

  @@index([created_at])
  @@index([order_id])
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  STAFF
  WAITER
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
  ACCEPTED
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
  FREE_TRIAL
  LIFETIME
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderSource {
  QR_SCAN
  POS_WAITER
  ONLINE_DIRECT
}

enum NotificationType {
  NEW_ORDER
  BILLING
  SYSTEM
  HELP_REQUEST
}

enum PasscodeResetStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LoyaltyTransactionType {
  EARN
  REDEMPTION
  REFUND
  MANUAL_ADJUSTMENT
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CampaignChannel {
  SMS
  EMAIL
  PUSH
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

enum CampaignLogStatus {
  PENDING
  SENT
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum RawMaterialStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  RECEIVED
  CANCELLED
}

enum WastageReason {
  SPOILAGE
  EXPIRED
  SPILLAGE
  PREP_WASTE
  THEFT
  OTHER
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LedgerActionType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  WASTAGE_RECORD
  TRANSFER_OUT
  TRANSFER_IN
  PHYSICAL_AUDIT
  MANUAL_ADJUSTMENT
}

enum EventType {
  QR_SCAN
  CART_VIEW
  MENU_ITEM_VIEW
  ORDER_ATTEMPT
}

enum ExpenseCategory {
  OPERATIONAL
  SALARY
  RENT
  UTILITIES
  MARKETING
  DEPRECIATION
  OTHER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model MenuViewLog {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  sessionId    String     @map("session_id")
  viewedAt     DateTime   @default(now()) @map("viewed_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([viewedAt])
  @@map("menu_view_logs")
}

model CartSession {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  sessionId    String     @map("session_id")
  isActive     Boolean    @default(true) @map("is_active")
  isAbandoned  Boolean    @default(false) @map("is_abandoned")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([sessionId])
  @@map("cart_sessions")
}

